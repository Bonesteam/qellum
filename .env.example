# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/qellum

# Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=30d
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# Corefy Payment Gateway
COREFY_API_URL=https://api.spoynt.com
COREFY_ACCOUNT_ID=your_corefy_account_id
COREFY_API_KEY=your_corefy_api_key
COREFY_PUBLIC_KEY=your_corefy_public_key
COREFY_WEBHOOK_SECRET=your_corefy_webhook_secret
COREFY_DEFAULT_SERVICE_GBP=payment_card_gbp_hpp
COREFY_DEFAULT_SERVICE_EUR=payment_card_eur_hpp
COREFY_DEFAULT_SERVICE_USD=payment_card_usd_hpp
COREFY_PUBLIC_APP_URL=https://www.qellum.co.uk

# Legacy Spoynt aliases (supported interchangeably)
SPOYNT_BASE_URL=https://api.spoynt.com
SPOYNT_ACCOUNT_ID=your_corefy_account_id
SPOYNT_API_KEY=your_corefy_api_key
SPOYNT_PUBLIC_KEY=your_corefy_public_key
SPOYNT_PRIVATE_KEY=your_corefy_webhook_secret
SPOYNT_DEFAULT_SERVICE_GBP=payment_card_gbp_hpp
SPOYNT_DEFAULT_SERVICE_EUR=payment_card_eur_hpp
SPOYNT_DEFAULT_SERVICE_USD=payment_card_usd_hpp
SPOYNT_PUBLIC_APP_URL=https://www.qellum.co.uk

# Email / SMTP
SMTP_HOST=smtp.tech-text.co.uk
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
RESEND_API=

# AI
OPENAI_API_KEY=
AI_COST_PER_REQUEST=tokens_per_request
